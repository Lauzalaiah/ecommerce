{% style %}
  .categories-{{ section.id }} {
    padding: 3rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .categories-{{ section.id }} .categories-heading {
    text-align: center;
    margin: 0 0 2rem;
  }
  .categories-{{ section.id }} .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }
  .categories-{{ section.id }} .category-card {
    position: relative;
    display: block;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    text-decoration: none;
    box-shadow: 0 18px 32px -22px rgba(0, 0, 0, 0.3);
  }
  .categories-{{ section.id }} .category-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  .categories-{{ section.id }} .category-card:hover img {
    transform: scale(1.06);
  }
  .categories-{{ section.id }} .category-card__label {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 1.15rem 1.1rem;
    background: linear-gradient(transparent, rgba(0,0,0,0.6));
    color: #fff;
    font-weight: 600;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .categories-{{ section.id }} .category-card__label svg {
    width: 18px;
    height: 18px;
    opacity: 0.85;
    transition: transform 0.2s ease;
  }
  .categories-{{ section.id }} .category-card:hover .category-card__label svg {
    transform: translateX(3px);
  }
{% endstyle %}

<div class="categories-{{ section.id }} color-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="categories-heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="categories-grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="category-card" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
        {%- endif -%}
        <span class="category-card__label">
          {{ block.settings.label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Univers Chien/Chat/Bien-être",
  "tag": "section",
  "class": "section-featured-categories",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Trouvez ce qu'il faut pour votre compagnon" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Palette de couleurs", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Catégorie",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Nom", "default": "Chiens" },
        { "type": "url", "id": "link", "label": "Lien vers la collection" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "category", "settings": { "label": "Chiens" } },
      { "type": "category", "settings": { "label": "Chats" } },
      { "type": "category", "settings": { "label": "Compléments & santé" } },
      { "type": "category", "settings": { "label": "Hygiène & soin" } }
    ]
  },
  "presets": [
    { "name": "Univers Chien/Chat/Bien-être" }
  ]
}
{% endschema %}
