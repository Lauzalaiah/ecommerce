{% style %}
  .hero-{{ section.id }} {
    position: relative;
    display: grid;
    place-items: center;
    min-height: {{ section.settings.min_height }}px;
    background: {{ section.settings.background_color }};
    overflow: hidden;
  }
  .hero-{{ section.id }}__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};
  }
  .hero-{{ section.id }}__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, {{ section.settings.background_color }} 0%, {{ section.settings.background_color | color_modify: 'alpha', 0.55 }} 45%, transparent 80%);
    pointer-events: none;
  }
  .hero-{{ section.id }}__content {
    position: relative;
    z-index: 1;
    max-width: 640px;
    text-align: {{ section.settings.text_alignment }};
    padding: 4rem 2rem;
    animation: hero-rise-{{ section.id }} 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-{{ section.id }}__content { animation: none; }
  }
  @keyframes hero-rise-{{ section.id }} {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .hero-{{ section.id }}__heading {
    font-size: clamp(2.1rem, 4.2vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0 0 1.1rem;
    color: {{ section.settings.text_color }};
    text-wrap: balance;
  }
  .hero-{{ section.id }}__subheading {
    font-size: 1.15rem;
    line-height: 1.55;
    margin: 0 0 2rem;
    color: {{ section.settings.text_color }};
    opacity: 0.88;
  }
  .hero-{{ section.id }}__cta {
    display: inline-flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: {{ section.settings.text_alignment }};
    margin-bottom: 1.75rem;
  }
  .hero-{{ section.id }}__cta .button--primary {
    box-shadow: 0 14px 28px -16px rgba(0, 0, 0, 0.35);
    transition: transform 0.15s ease;
  }
  .hero-{{ section.id }}__cta .button--primary:hover {
    transform: translateY(-2px);
  }
  .hero-{{ section.id }}__trust-strip {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: {{ section.settings.text_alignment }};
    font-size: 0.85rem;
    font-weight: 500;
    color: {{ section.settings.text_color }};
    opacity: 0.85;
  }
  .hero-{{ section.id }}__trust-strip span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero-{{ section.id }}__trust-strip svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
{% endstyle %}

<div class="hero-{{ section.id }} color-{{ section.settings.color_scheme }}">
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'hero-' | append: section.id | append: '__image', loading: 'eager', fetchpriority: 'high' }}
    <div class="hero-{{ section.id }}__scrim"></div>
  {%- endif -%}

  <div class="hero-{{ section.id }}__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="hero-{{ section.id }}__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <div class="hero-{{ section.id }}__subheading">{{ section.settings.subheading }}</div>
    {%- endif -%}
    <div class="hero-{{ section.id }}__cta">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button button--primary">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 | default: '#' }}" class="button button--secondary">
          {{ section.settings.button_label_2 }}
        </a>
      {%- endif -%}
    </div>
    {%- if section.settings.show_trust_strip -%}
      <div class="hero-{{ section.id }}__trust-strip">
        <span>{% render 'icon-benefit', icon: 'truck' %} {{ section.settings.trust_1 }}</span>
        <span>{% render 'icon-benefit', icon: 'shield' %} {{ section.settings.trust_2 }}</span>
        <span>{% render 'icon-benefit', icon: 'lock' %} {{ section.settings.trust_3 }}</span>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero bien-être",
  "tag": "section",
  "class": "section-hero-bienetre",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image de fond" },
    { "type": "range", "id": "image_opacity", "label": "Opacité de l'image", "min": 20, "max": 100, "step": 5, "default": 90 },
    { "type": "range", "id": "min_height", "label": "Hauteur minimale (px)", "min": 300, "max": 800, "step": 20, "default": 560 },
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "default": "Le bien-être de votre compagnon, livré chez vous" },
    { "type": "richtext", "id": "subheading", "label": "Sous-titre", "default": "<p>Croquettes, friandises et soins sélectionnés pour la santé de votre chien ou chat.</p>" },
    { "type": "text", "id": "button_label", "label": "Bouton principal — texte", "default": "Découvrir la boutique" },
    { "type": "url", "id": "button_link", "label": "Bouton principal — lien" },
    { "type": "text", "id": "button_label_2", "label": "Bouton secondaire — texte", "default": "Notre engagement bien-être" },
    { "type": "url", "id": "button_link_2", "label": "Bouton secondaire — lien" },
    { "type": "checkbox", "id": "show_trust_strip", "label": "Afficher le mini bandeau de réassurance", "default": true },
    { "type": "text", "id": "trust_1", "label": "Réassurance 1", "default": "Livraison 24-48h" },
    { "type": "text", "id": "trust_2", "label": "Réassurance 2", "default": "Satisfait ou remboursé" },
    { "type": "text", "id": "trust_3", "label": "Réassurance 3", "default": "Paiement sécurisé" },
    { "type": "select", "id": "text_alignment", "label": "Alignement du texte", "default": "left", "options": [
      { "value": "left", "label": "Gauche" },
      { "value": "center", "label": "Centré" }
    ]},
    { "type": "color", "id": "background_color", "label": "Couleur de fond", "default": "#EEF1EC" },
    { "type": "color", "id": "text_color", "label": "Couleur du texte", "default": "#1B2A22" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Palette de couleurs", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Hero bien-être" }
  ]
}
{% endschema %}
