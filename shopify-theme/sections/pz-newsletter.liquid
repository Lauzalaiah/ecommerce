{% style %}
  .newsletter-{{ section.id }} {
    padding: 3.5rem 1.5rem;
    text-align: center;
  }
  .newsletter-{{ section.id }} .newsletter-card {
    max-width: 640px;
    margin: 0 auto;
    padding: 2.5rem 2rem;
    border-radius: 20px;
    background: rgba(0, 0, 0, 0.025);
    border: 1px solid rgba(0, 0, 0, 0.06);
  }
  .newsletter-{{ section.id }} h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
  }
  .newsletter-{{ section.id }} form {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1.5rem;
  }
  .newsletter-{{ section.id }} input[type="email"] {
    flex: 1 1 240px;
    padding: 0.85rem 1.1rem;
    border-radius: 10px;
    border: 1px solid rgba(0,0,0,0.15);
    font-size: 1rem;
  }
  .newsletter-{{ section.id }} input[type="email"]:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
{% endstyle %}

<div class="newsletter-{{ section.id }} color-{{ section.settings.color_scheme }}">
 <div class="newsletter-card">
  <h2>{{ section.settings.heading }}</h2>
  <div>{{ section.settings.text }}</div>

  {%- form 'customer', id: 'newsletter-form-' | append: section.id -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="newsletter-form-fields">
      <input
        type="email"
        name="contact[email]"
        placeholder="{{ section.settings.email_placeholder }}"
        required
        aria-label="{{ section.settings.email_placeholder }}"
      >
      <button type="submit" class="button button--primary">{{ section.settings.button_label }}</button>
    </div>
    {%- if form.posted_successfully? -%}
      <p>{{ section.settings.success_message }}</p>
    {%- endif -%}
  {%- endform -%}
 </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "10 % de réduction sur votre première commande" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Inscrivez-vous pour recevoir le code et nos conseils bien-être animal.</p>" },
    { "type": "text", "id": "email_placeholder", "label": "Placeholder email", "default": "Votre adresse email" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Je m'inscris" },
    { "type": "text", "id": "success_message", "label": "Message de confirmation", "default": "Merci ! Vérifiez votre boîte mail pour votre code de réduction." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Palette de couleurs", "default": "scheme-2" }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
