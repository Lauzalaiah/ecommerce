{% style %}
  .subscribe-save-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
    padding: 3rem 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }
  @media screen and (min-width: 750px) {
    .subscribe-save-{{ section.id }} {
      grid-template-columns: 1fr 1fr;
      text-align: left;
    }
  }
  .subscribe-save-{{ section.id }} .subscribe-save__image img {
    width: 100%;
    border-radius: 12px;
  }
  .subscribe-save-{{ section.id }} .subscribe-save__badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: rgba(0,0,0,0.06);
    margin-bottom: 0.75rem;
  }
{% endstyle %}

<div class="subscribe-save-{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="subscribe-save__image">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
    {%- endif -%}
  </div>
  <div class="subscribe-save__content">
    <span class="subscribe-save__badge">{{ section.settings.badge }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <div>{{ section.settings.text }}</div>
    {%- if section.settings.button_label != blank -%}
      <p><a href="{{ section.settings.button_link | default: '#' }}" class="button button--primary">{{ section.settings.button_label }}</a></p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Abonnement croquettes",
  "tag": "section",
  "class": "section-subscribe-save",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "Nouveau" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ne soyez plus jamais à court de croquettes" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Abonnez-vous à une livraison récurrente et économisez 10 % sur chaque commande. Modifiable ou annulable à tout moment.</p>" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Voir les produits éligibles" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Palette de couleurs", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Abonnement croquettes" }
  ]
}
{% endschema %}
