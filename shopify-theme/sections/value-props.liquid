{% style %}
  .value-props-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    padding: 3rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .value-props-{{ section.id }} .value-prop {
    text-align: center;
  }
  .value-props-{{ section.id }} .value-prop__icon {
    width: 40px;
    height: 40px;
    margin: 0 auto 0.75rem;
  }
  .value-props-{{ section.id }} .value-prop__title {
    font-weight: 600;
    margin: 0 0 0.25rem;
  }
  .value-props-{{ section.id }} .value-prop__text {
    font-size: 0.9rem;
    opacity: 0.8;
    margin: 0;
  }
{% endstyle %}

<div class="value-props-{{ section.id }} color-{{ section.settings.color_scheme }}">
  {%- for block in section.blocks -%}
    <div class="value-prop" {{ block.shopify_attributes }}>
      <div class="value-prop__icon">{% render 'icon-paw' %}</div>
      <p class="value-prop__title">{{ block.settings.title }}</p>
      <p class="value-prop__text">{{ block.settings.text }}</p>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Nos engagements",
  "tag": "section",
  "class": "section-value-props",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Palette de couleurs", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "value_prop",
      "name": "Engagement",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Livraison en 24-48h" },
        { "type": "text", "id": "text", "label": "Description", "default": "Partout en France métropolitaine" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "value_prop", "settings": { "title": "Livraison en 24-48h", "text": "Partout en France métropolitaine" } },
      { "type": "value_prop", "settings": { "title": "Sélectionné avec soin", "text": "Ingrédients naturels, sans additifs superflus" } },
      { "type": "value_prop", "settings": { "title": "Satisfait ou remboursé", "text": "30 jours pour changer d'avis" } },
      { "type": "value_prop", "settings": { "title": "Paiement sécurisé", "text": "Carte, PayPal, 3x sans frais" } }
    ]
  },
  "presets": [
    { "name": "Nos engagements" }
  ]
}
{% endschema %}
